# KnowledgeFlow AI: the one settings file for the whole project.
# Copy it to .env in this same folder (the repository root) and fill it in.
# The backend reads every key; the frontend reads only the NEXT_PUBLIC_* keys.
# Never commit .env.

# ===================================================================
# Backend
# ===================================================================

# --- Core
DATABASE_URL=postgresql+psycopg2://postgres:YOUR_PASSWORD@localhost:5432/knowledgeflow
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

# --- LLM (Groq)
GROQ_API_KEY=
GROQ_LLM_MODEL=openai/gpt-oss-20b

# --- Embeddings (local model, no key needed)
EMBEDDING_MODEL=all-MiniLM-L6-v2
EMBEDDING_DIM=384

# --- Retrieval
TOP_K=5
# Grounding gate: best cosine distance must be <= this (or a full-text hit) to answer
SIMILARITY_THRESHOLD=0.8

# --- Reranking (local cross-encoder)
RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

# --- Query transformation: comma-separated default (rewrite, expand, multi_query, hyde); empty = off
QUERY_TRANSFORMS=
MULTI_QUERY_COUNT=3

# --- Multimodal ingestion
OCR_ENABLED=true
OCR_MIN_CONFIDENCE=0.5
OCR_RENDER_DPI=150
OCR_MAX_PAGES=20
OCR_MAX_IMAGES=15
TABLES_ENABLED=true
MAX_UPLOAD_MB=25

# --- Authentication & access control
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_REQUIRED=false
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
REGISTRATION_OPEN=true
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Production runtime
# true: uploads return 202 at once and a worker ingests them (`python -m app.worker`)
INGEST_ASYNC=false
# true: the API process runs one worker thread itself (single-process deployment)
RUN_EMBEDDED_WORKER=false
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_STALE_AFTER_SECONDS=900
EMBED_CACHE_SIZE=1024
# text | json (one JSON object per line; secrets are redacted in both)
LOG_FORMAT=text
# Bearer token for GET /metrics (>= 24 chars). Empty: open with auth off, disabled with auth on.
METRICS_TOKEN=

# ===================================================================
# Frontend (public: these values are built into the browser bundle, so never put secrets here)
# ===================================================================
NEXT_PUBLIC_API_URL=http://localhost:8000
