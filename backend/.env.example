DATABASE_URL=postgresql+psycopg2://kf_user:kf_password@db:5432/knowledgeflow
ENVIRONMENT=development
LOG_LEVEL=INFO
CORS_ORIGINS=http://localhost:3000

OPENAI_API_KEY=sk-your-key-here
EMBEDDING_MODEL=text-embedding-3-small
LLM_MODEL=gpt-4o-mini
EMBEDDING_DIM=1536
TOP_K=5
SIMILARITY_THRESHOLD=0.8

RERANK_ENABLED=true
RERANK_MODEL=cross-encoder/ms-marco-MiniLM-L-6-v2
RERANK_CANDIDATES=20

QUERY_TRANSFORMS=
MULTI_QUERY_COUNT=3
# --- Phase 15: authentication & access control
# Generate a secret with: python -c "import secrets; print(secrets.token_urlsafe(48))"
AUTH_REQUIRED=false
JWT_SECRET=
JWT_EXPIRE_MINUTES=60
REGISTRATION_OPEN=true
PASSWORD_MIN_LENGTH=10
RATE_LIMIT_ENABLED=true
RATE_LIMIT_AUTH_PER_MINUTE=10
RATE_LIMIT_LLM_PER_MINUTE=30
RATE_LIMIT_DEFAULT_PER_MINUTE=300

# --- Production runtime (Phase 16) ---
# true: uploads return 202 at once and a worker ingests them (`python -m app.worker`)
INGEST_ASYNC=false
# true: the API process runs one worker thread itself (single-process deployment)
RUN_EMBEDDED_WORKER=false
JOB_MAX_ATTEMPTS=3
JOB_RETRY_BASE_SECONDS=10
JOB_STALE_AFTER_SECONDS=900
EMBED_CACHE_SIZE=1024
# text | json (one JSON object per line; secrets are redacted in both)
LOG_FORMAT=text
# Bearer token for GET /metrics (>= 24 chars). Empty: open with auth off, disabled with auth on.
METRICS_TOKEN=
